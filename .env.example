APP_NAME=FinWatch
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://finwatch:finwatch@postgres:5432/finwatch
ASYNC_DATABASE_URL=postgresql+asyncpg://finwatch:finwatch@postgres:5432/finwatch
REDIS_URL=redis://redis:6379/0
ML_RULE_WEIGHT=0.4
ML_SCORE_WEIGHT=0.6
ML_ALERT_THRESHOLD=60.0
PROFILE_WORKER_INTERVAL_SECONDS=300
PROFILE_WORKER_BATCH_SIZE=500
PROFILE_WORKER_MAX_RUNTIME_SECONDS=240
PROFILE_WORKER_LOCK_TTL=600
PROFILE_DLQ_INTERVAL_SECONDS=600
PROFILE_DLQ_BATCH_SIZE=200
PROFILE_DLQ_MAX_ATTEMPTS=5
AUTH_API_KEY=replace-with-an-api-key
